# IDE / editor local state
.idea/
.vscode/
.cursorrules
*.swp
*.swo
*~

# OS junk (never useful in repo)
.DS_Store
Thumbs.db

# Local environment files (never commit -- contain secrets)
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env.example.*

# Build
*.log
dist/
dist-bin/
build/
out/
test-results/
coverage/

# Rust build artefacts
target/
Cargo.lock
**/*.rs.bk
*.pdb
*.profraw
*.profdata
coverage-html/
coverage.lcov
tarpaulin-report.json
cobertura.xml

# cargo -- everything local except the two committed config files. The
# excluded pattern has to be the directory CONTENTS, not the directory
# itself: git never descends into an excluded directory, so a negation
# under `.cargo/` would never be reached.
/.cargo/*
!/.cargo/config.toml
!/.cargo/audit.toml

# Git worktrees (local dev convenience)
.worktrees/

# AI agent working files -- local-only, never committed. Mirrored in
# .git/info/exclude, because a tracked .gitignore alone does not protect a
# clone that has not pulled it yet.
docs/superpowers/
.hyperi-ai/
CLAUDE.md
STATE.md
TODO.md
AGENTS.md
GEMINI.md
.ai-version
.mcp.json
.claude/
.codex/
.cursor/
.gemini/

# Local scratch / tmp (CORE.md: scratch goes here, gitignored, NOT
# /tmp). Bare patterns (no leading slash) match a tmp dir at ANY
# depth, so these cover top-level .tmp/ and tmp/ as well as nested
# ones like tests/tmp/.
.tmp/
tmp/
